{
    "name": "@sakurakoi/opencode-auto-approval-plugin",
    "version": "0.1.1",
    "description": "opencode plugin that auto-approves tool permission requests based on configurable rules",
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "permission",
        "auto-approval",
        "typescript"
    ],
    "homepage": "https://github.com/SakuraKoi/opencode-auto-approval-plugin#readme",
    "bugs": {
        "url": "https://github.com/SakuraKoi/opencode-auto-approval-plugin/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SakuraKoi/opencode-auto-approval-plugin.git"
    },
    "license": "MIT",
    "author": "dyoshikawa,SakuraKooi",
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsdown",
        "check": "pnpm run fmt:check && pnpm run oxlint && pnpm run typecheck",
        "cicheck": "pnpm run cicheck:code && pnpm run cicheck:content",
        "cicheck:code": "pnpm run check && pnpm run test",
        "cicheck:content": "pnpm run cspell && pnpm run secretlint",
        "cspell": "cspell --no-progress --gitignore .",
        "fix": "pnpm run fmt && pnpm run oxlint:fix",
        "fmt": "oxfmt .",
        "fmt:check": "oxfmt --check .",
        "generate": "rulesync generate",
        "knip": "knip",
        "oxlint": "oxlint . --max-warnings 0",
        "oxlint:fix": "oxlint . --fix --max-warnings 0",
        "prepare": "simple-git-hooks && pnpm generate",
        "prepublishOnly": "pnpm build",
        "secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
        "sort": "sort-package-json",
        "test": "vitest run --silent=true",
        "test:coverage": "vitest run --coverage --silent=true",
        "test:watch": "vitest --silent=true",
        "typecheck": "tsc --noEmit"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm exec lint-staged"
    },
    "dependencies": {
        "@opencode-ai/sdk": "1.18.21",
        "zod": "4.1.12"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "1.18.21",
        "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
        "@tsconfig/node22": "22.0.5",
        "@types/node": "26.1.2",
        "@vitest/coverage-v8": "4.1.10",
        "cspell": "10.0.1",
        "knip": "6.31.0",
        "lint-staged": "17.3.0",
        "oxfmt": "0.61.0",
        "oxlint": "1.76.0",
        "rulesync": "16.5.0",
        "secretlint": "13.0.4",
        "simple-git-hooks": "2.13.1",
        "sort-package-json": "4.0.0",
        "tsdown": "0.22.14",
        "tsx": "4.23.5",
        "typescript": "7.0.2",
        "vitest": "4.1.10"
    },
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.18.21 <2"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=10"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com"
    }
}
